# 이 파일을 .env 로 복사해서 채운다. .env 는 커밋하지 않는다.

# Discord 앱 (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# 관리자 Discord 사용자 ID. 쉼표로 구분, 최대 5명 (넘으면 앞 5명만 적용하고 에러 로그)
DISCORD_ADMIN_IDS=
# 웹 주소. OAuth redirect 는 {PUBLIC_BASE_URL}/auth/callback. https 면 세션 쿠키에 Secure 가 붙는다
PUBLIC_BASE_URL=https://ktx.example.com
# Cloudflare Tunnel 토큰 (Zero Trust > Networks > Tunnels). dev·prod 가 같은 터널, 같은 도메인을 번갈아 쓴다
CLOUDFLARE_TUNNEL_TOKEN=
# 터널을 쓸 때만 켠다(cloudflared 컨테이너가 뜬다). 로컬로만 쓰면 이 줄을 지우고
# PUBLIC_BASE_URL 을 http://localhost:12971 (dev) 또는 http://localhost:12972 (prod) 로 둔다
COMPOSE_PROFILES=tunnel
# 32자 이상 난수: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# 선택
TELEGRAM_BOT_TOKEN=
# 선택. 공공데이터포털(data.go.kr) '한국철도공사_열차운행정보' 활용신청 후 받은 일반 인증키(Decoding).
# 있으면 일주일마다 최근 8주 운행 기록으로 열차 시간표와 직통 노선을 다시 만들고, 없으면 앱에 들어 있는 초기 시간표를 쓴다
DATA_GO_KR_KEY=

# 감시
WATCH_CUTOFF_MINUTES=60
SCAN_INTERVAL_MIN=40
SCAN_INTERVAL_MAX=80
PAGE_GAP_MIN=1
PAGE_GAP_MAX=2
MAX_FAILS=10
# 연속 실패로 조회를 멈춘 뒤 다시 시도하기까지(분)
BLOCK_COOLDOWN_MINUTES=30
MAX_ACTIVE_WATCHES=10
MAX_WATCH_DAYS=3

# 로그. DEBUG 면 페이지별 조회 로그와 스택트레이스까지 남긴다
LOG_LEVEL=INFO
