# 원격 조회 노드 설정. .env.node 로 복사해서 채운다. 커밋하지 않는다.

# 중앙 주소(중앙의 PUBLIC_BASE_URL)
CENTRAL_URL=https://ktx.example.com
# 웹 > 조회 노드 > 노드 추가 에서 발급한 토큰(발급할 때 한 번만 보인다)
NODE_TOKEN=
# Cloudflare Access 서비스 토큰(Zero Trust > Access > Service Auth). 도메인에 Access 를 걸었으면 필요하다
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

LOG_LEVEL=INFO
